
# ============================================
# SOLARVISION AI - GITIGNORE
# ============================================

# ============================================
# 1. PYTHON
# ============================================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ============================================
# 2. ENVIRONMENT & SECRETS
# ============================================
.env
.env.*
!.env.example

# ============================================
# 3. IDE
# ============================================
.vscode/
.idea/

# ============================================
# 4. MLFLOW
# ============================================
mlruns/
mlartifacts/
mlflow.db

# ============================================
# 5. TRAINED MODELS - DVC
# ============================================

# Ignore model artifacts
models/**

# Allow subdirectories and DVC metadata
!models/**/
!models/**/*.dvc
!models/**/.gitignore

# Ignore training outputs
runs/**

# Allow DVC metadata inside runs
!runs/**/
!runs/**/*.dvc
!runs/**/.gitignore

# Ignore model weights
/weights/
*.pt
*.pth
*.onnx

# ============================================
# 6. DATASETS
# ============================================

# Original downloaded datasets
datasets/

# Intermediate and processed datasets
data/interim/
data/processed/

# IMPORTANT:
# Do not ignore data/raw/
# DVC tracks its datasets through .dvc files.
# Dataset folders are ignored by data/raw/.gitignore.

# ============================================
# 7. GENERATED OUTPUTS
# ============================================
outputs/

# ============================================
# 8. FRONTEND REACT
# ============================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ============================================
# 9. OPERATING SYSTEM
# ============================================
.DS_Store
Thumbs.db

# ============================================
# 10. TEMPORARY FILES
# ============================================
*.log
*.tmp
*.bak
