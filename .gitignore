
# ============================================
# SOLARVISION AI - GITIGNORE
# ============================================

# ============================================
# 1. PYTHON
# ============================================
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ============================================
# 2. ENVIRONMENT & SECRETS
# ============================================
.env
.env.*
!.env.example

# ============================================
# 3. IDE
# ============================================
.vscode/
.idea/

# ============================================
# 4. MLFLOW
# ============================================
mlruns/
mlartifacts/
mlflow.db

# ============================================
# 5. TRAINED MODELS - DVC
# ============================================

# Ignore model artifacts
models/**

# Allow subdirectories and DVC metadata
!models/**/
!models/**/*.dvc
!models/**/.gitignore

# Ignore training outputs
runs/**

# Allow DVC metadata inside runs
!runs/**/
!runs/**/*.dvc
!runs/**/.gitignore

# Ignore model weights
/weights/
*.pt
*.pth
*.onnx

# ============================================
# 6. DATASETS
# ============================================

# Original downloaded datasets
datasets/

# Intermediate and processed datasets
data/interim/
data/processed/

# IMPORTANT:
# Do not ignore data/raw/
# DVC tracks its datasets through .dvc files.
# Dataset folders are ignored by data/raw/.gitignore.

# ============================================
# 7. GENERATED OUTPUTS
# ============================================
outputs/

# ============================================
# 8. FRONTEND REACT
# ============================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ============================================
# 9. OPERATING SYSTEM
# ============================================
.DS_Store
Thumbs.db

# ============================================
# 10. TEMPORARY FILES
# ============================================
*.log
*.tmp
*.bak

# Runtime inspection reports and previews
data/inspections.sqlite3*
frontend/.output/
frontend/.nitro/

# ============================================
# 11. PRIVATE VALIDATION EVIDENCE AND BACKUPS
# ============================================
# Contains SQLite copies, browser histories, raw responses and local fixtures.
# Publish only the reviewed summaries under docs/validation/.
/reports/audits/
/backups/
/storage/
/artifacts/
# Existing evaluation mosaics contain dataset pixels. Keep their local files;
# the publication plan removes only their Git index entries after approval.
/reports/detection/**/test_evaluation/val_batch*.jpg
frontend/test-results/
frontend/playwright-report/
frontend/.e2e/

# Databases and journals, wherever a local tool creates them.
*.db
*.db-wal
*.db-shm
*.db*
*.sqlite*

# Local archives are DVC-managed artifacts, not source files.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Local authentication, keys and agent/provider configuration.
.dvc/config.local
credentials*.json
client_secret*.json
token.json
token.pickle
*.pem
*.key
id_rsa*
id_ed25519*
.aws/
.kube/
.codex/
.agents/
